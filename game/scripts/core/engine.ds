-- Главный цикл. Игра запускается сразу в лобби: экрана "играть / выход" нет,
-- как и любого другого меню.

public function init()
    ds_log("init: загрузка спрайтов")
    load_textures()
    start_music()
    setup_arena()
    layout_controls()
    place_fighter(hero, ar_x + ar_w * 0.4, ar_y + ar_h * 0.6)
    place_fighter(foe, ar_x + ar_w * 0.6, ar_y + ar_h * 0.45)
    start_lobby(lobby_first)
    ds_log("init: лобби готово")
end

public function update()
    ensure_arena()
    layout_controls()
    reload_textures()
    update_music()
    if phase == PH_ROUND then
        update_round()
    else if phase == PH_RESULT then
        update_result()
    else
        update_lobby()
    end
end

public function draw()
    if phase == PH_LOBBY then
        draw_lobby()
        return
    end
    draw_round()
end
