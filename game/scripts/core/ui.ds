-- Мелкие помощники интерфейса: центрированный текст, плашки, таймер, затухания.

public function tick_down(number t)
    if t <= 0 then
        return 0
    end
    if t - dt <= 0 then
        return 0
    end
    return t - dt
end

-- Цвет с альфой: rgb без альфа-канала плюс прозрачность 0..1. Ноль в старших
-- битах означал бы непрозрачный цвет, поэтому минимальная альфа равна 1.
public function alpha_color(number rgb, number a)
    local number k = clamp(a, 0, 1)
    return (1 + floor(k * 254)) * 0x1000000 + rgb
end

public function ctext(string s, number y, number c)
    text(s, (screen_w - text_ink_width(s)) / 2, y, c)
end

public function ctext_scaled(string s, number y, number c, number scale)
    text_scaled(s, (screen_w - text_ink_width(s) * scale) / 2, y, c, scale)
end

-- Текст по центру прямоугольника: по ширине и по реальной высоте букв.
public function text_in_box(string s, number x, number y, number w, number h, number c, number scale)
    local number tw = text_ink_width(s) * scale
    local number th = text_ink_height(s) * scale
    local number tt = text_ink_top(s) * scale
    text_scaled(s, x + (w - tw) / 2, y + (h - th) / 2 - tt + 1.5, c, scale)
end

-- Плашка под текст: тёмный прямоугольник со скруглением.
public function plate(number x, number y, number w, number h, number c)
    roundrect(x, y, w, h, 16, c)
end

public function hit_circle(number px, number py, number cx, number cy, number r)
    if dist(px, py, cx, cy) <= r then
        return 1
    end
    return 0
end

-- Секунды в "М:СС" для таймера раунда и обратного отсчёта лобби.
public function fmt_time(number t)
    local number s = floor(t)
    if s < 0 then
        s = 0
    end
    local number m = floor(s / 60)
    local number rest = s - m * 60
    -- Возврат склейки идёт через переменную: тип возвращаемого значения
    -- компилятор берёт из объявления, а не из выражения.
    local string out = "" + m + ":" + rest
    if rest < 10 then
        out = "" + m + ":0" + rest
    end
    return out
end

-- Цвет роли: убийца красный, выживший голубой.
public function role_color(number role)
    if role == ROLE_KILLER then
        return col_killer
    end
    return col_survivor
end

public function role_title(number role)
    if role == ROLE_KILLER then
        return TXT_YOU_KILLER
    end
    return TXT_YOU_SURVIVOR
end

public function role_task(number role)
    if role == ROLE_KILLER then
        return TXT_TASK_KILLER
    end
    return TXT_TASK_SURVIVOR
end

public function result_title(number res)
    if res == RES_KILLER then
        return TXT_WIN_KILLER
    end
    return TXT_WIN_SURVIVORS
end

-- Победил ли игрок при таком итоге: убийца выигрывает только по RES_KILLER.
public function hero_won(number res)
    if res == RES_KILLER then
        if hero.role == ROLE_KILLER then
            return 1
        end
        return 0
    end
    if hero.role == ROLE_SURVIVOR then
        return 1
    end
    return 0
end

-- Полоска жизней выжившего: hp кружков подряд.
public function draw_hearts(number x, number y, number hp)
    local number i = 0
    local number r = 11
    local number gap = 30
    while i < survivor_hp do
        if i < hp then
            circle(x + i * gap, y, r, col_hp_on)
        else
            circle(x + i * gap, y, r, col_hp_off)
        end
        i = i + 1
    end
end
