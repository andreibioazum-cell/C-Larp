-- Раунды: убийца против выжившего. Здесь только константы - фазы, тайминги,
-- размеры арены, скорости, параметры удара и палитра. Никакого меню в игре нет:
-- при запуске сразу лобби, из лобби раунд, после раунда снова лобби.

-- Фазы игры. PH_LOBBY - перерыв между раундами, PH_ROUND - сам раунд,
-- PH_RESULT - плашка с итогом сразу после раунда.
public number PH_LOBBY=0, PH_ROUND=1, PH_RESULT=2

-- Роли в раунде: выживший не умеет бить, убийца умеет.
public number ROLE_SURVIVOR=0, ROLE_KILLER=1

-- Итог раунда.
public number RES_NONE=0, RES_SURVIVORS=1, RES_KILLER=2

-- Тайминги (секунды). round_time - те самые три минуты, которые надо прожить,
-- lobby_break - перерыв в лобби после раунда, lobby_first - короткая пауза
-- самого первого входа, чтобы игрок успел увидеть лобби.
public number round_time=180
public number lobby_break=40
public number lobby_first=6
public number result_time=4
public number announce_time=2.2

-- Арена: пол выложен плиткой grass.png, бойцы не выходят за рамку wall_pad,
-- внутри стоят столбы, вокруг которых выживший водит убийцу.
public number arena_tile=256
public number wall_pad=56
public number pillar_r=44
public number pillar_count=5
public number pi=3.1415926535

-- Бойцы. Спрайт 50x50, тело - кубик в пикселях 9..40, то есть половина 16.
public number body_half=16
public number fighter_scale=1.8
public number survivor_speed=256
public number killer_speed=234
public number survivor_hp=3
public number hit_invuln=1.8
-- Пока горит неуязвимость, выживший бежит быстрее: пропущенный удар отбрасывает
-- и даёт оторваться, а не начинает добивание.
public number hurt_speed_mult=1.3
public number knockback=86

-- Удар убийцы состоит из двух частей. Сначала замах: убийца замирает, и на
-- земле видно, куда он ударит - направление в этот момент уже зафиксировано.
-- Потом выпад: рывок вперёд быстрее бега с активной зоной. В прямом беге
-- выживший быстрее, так что убийца берёт выпадом, а выживший - шагом вбок,
-- пока идёт замах.
public number punch_windup=0.2
public number punch_time=0.16
public number punch_cooldown=0.55
public number lunge_mult=2.4
-- После удачного попадания замах перезаряжается дольше: у выжившего есть
-- окно, чтобы оторваться, пока горит неуязвимость.
public number hit_cooldown=1.2
public number punch_reach=58
public number punch_arc=0.45
public number punch_fade=0.22

-- Бот: пауза между решениями и ошибка прицела, чтобы он не был идеальным.
public number bot_think_min=0.10
public number bot_think_max=0.32
public number bot_aim_error=0.35
public number bot_probe=120
public number bot_dirs=12
public number bot_punch_range=0.86
-- Дальше этого расстояния убегать бессмысленно: выживший выбирает не самую
-- дальнюю точку, а самую свободную.
public number flee_enough=700
public number bot_wander_pause=1.6

-- Лобби: бойцы просто гуляют, удары выключены.
public number lobby_speed=190

-- Палитра. Альфа 0 в старших битах значит непрозрачный цвет (pack_c), поэтому
-- сплошные цвета пишутся без альфы, а прозрачность добавляет alpha_color().
public number col_bg=0x12151C
public number col_text=0xFFFFFF
public number col_dim=0xB9C3D6
public number col_killer=0xFF4444
public number col_survivor=0x4FC3F7
public number col_plate=0xCC161B26
public number col_plate_line=0x2A3441
public number col_pillar=0x3A2E24
public number col_pillar_top=0x5A4736
public number col_shadow=0x44000000
public number col_veil=0xB2070A10
public number col_joy=0x55FFFFFF
public number col_joy_knob=0xCCFFFFFF
public number col_btn=0xE6C8322F
public number col_btn_down=0xE6F0544F
public number col_hp_on=0xE94560
public number col_hp_off=0x66202833

-- Размеры интерфейса.
public number hud_pad=26
public number plate_h=54
public number joy_r=74
public number joy_grab=0.55
public number btn_r=94
public number btn_margin=150

-- Текстуры и звук.
public string GRASS="grass.png"
public string SURVIVOR_TEX="ordinary.png"
public string SURVIVOR_PUNCH_TEX="ordinary_punch.png"
public string KILLER_TEX="zombie_azum.png"
public string KILLER_PUNCH_TEX="zombie_azum_punch.png"
public string LOBBY_MUSIC="lobbymusic.wav"
public number music_volume=60
public number music_fade_in_time=0.8
public number music_fade_out_time=0.5

-- Строки. Игра на русском, одного языка достаточно: переключателя нет,
-- потому что нет и меню.
public string TXT_LOBBY="ЛОББИ"
public string TXT_NEXT="До раунда"
public string TXT_ROUND="Раунд"
public string TXT_RULES="Один убийца, один выживший. Продержись 3:00."
public string TXT_LAST="Прошлый раунд:"
public string TXT_YOU_KILLER="ТЫ УБИЙЦА"
public string TXT_YOU_SURVIVOR="ТЫ ВЫЖИВШИЙ"
public string TXT_TASK_KILLER="Найди и убей выжившего"
public string TXT_TASK_SURVIVOR="Продержись 3 минуты"
public string TXT_WIN_SURVIVORS="ВЫЖИВШИЕ ПОБЕДИЛИ"
public string TXT_WIN_KILLER="УБИЙЦА ВЫИГРАЛ"
public string TXT_YOU_WON="Ты победил"
public string TXT_YOU_LOST="Ты проиграл"
public string TXT_HIT="УДАР"
public string TXT_YOU="Ты"
public string TXT_BOT="Бот"
