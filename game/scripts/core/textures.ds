-- Загрузка спрайтов и повторы неудачных попыток. Первая загрузка на холодном
-- старте иногда промахивается (хранилище ассетов ещё прогревается), поэтому
-- флаги не считаются приговором: промахи переспрашиваются пару раз в секунду
-- первые полминуты, дальше раз в tex_reload_slow секунд.

public function load_textures()
    grass_tex_ok = png_load(GRASS)
    surv_tex_ok = png_load(SURVIVOR_TEX)
    surv_punch_tex_ok = png_load(SURVIVOR_PUNCH_TEX)
    killer_tex_ok = png_load(KILLER_TEX)
    killer_punch_tex_ok = png_load(KILLER_PUNCH_TEX)
    tex_reload_t = 0
    tex_reload_left = 60
end

public function textures_all_ok()
    if grass_tex_ok == 0 || surv_tex_ok == 0 then
        return 0
    end
    if surv_punch_tex_ok == 0 || killer_tex_ok == 0 || killer_punch_tex_ok == 0 then
        return 0
    end
    return 1
end

public function reload_textures()
    if tex_reload_left <= 0 && textures_all_ok() == 1 then
        return
    end
    if tex_reload_t > 0 then
        tex_reload_t = tex_reload_t - dt
        return
    end
    if tex_reload_left > 0 then
        tex_reload_t = 0.5
        tex_reload_left = tex_reload_left - 1
    else
        tex_reload_t = tex_reload_slow
    end
    if grass_tex_ok == 0 then
        grass_tex_ok = png_load(GRASS)
    end
    if surv_tex_ok == 0 then
        surv_tex_ok = png_load(SURVIVOR_TEX)
    end
    if surv_punch_tex_ok == 0 then
        surv_punch_tex_ok = png_load(SURVIVOR_PUNCH_TEX)
    end
    if killer_tex_ok == 0 then
        killer_tex_ok = png_load(KILLER_TEX)
    end
    if killer_punch_tex_ok == 0 then
        killer_punch_tex_ok = png_load(KILLER_PUNCH_TEX)
    end
    if textures_all_ok() == 1 then
        tex_reload_left = 0
    end
end

-- Музыка лобби: играет в перерыве и на итогах, в раунде затихает.
public function start_music()
    music_ok = snd_load(LOBBY_MUSIC)
    if music_ok == 0 then
        ds_log("init: нет музыки лобби")
        return
    end
    music_level = 1
    snd_volume(LOBBY_MUSIC, music_volume / 100)
    snd_loop(LOBBY_MUSIC)
end

public function update_music()
    if music_ok == 0 then
        return
    end
    if phase == PH_ROUND then
        music_level = clamp(music_level - dt / music_fade_out_time, 0, 1)
        snd_volume(LOBBY_MUSIC, music_volume / 100 * music_level)
        if music_level <= 0 && snd_playing(LOBBY_MUSIC) == 1 then
            snd_stop(LOBBY_MUSIC)
        end
        return
    end
    if snd_playing(LOBBY_MUSIC) == 0 then
        music_level = 0
        snd_loop(LOBBY_MUSIC)
    end
    music_level = clamp(music_level + dt / music_fade_in_time, 0, 1)
    snd_volume(LOBBY_MUSIC, music_volume / 100 * music_level)
end
