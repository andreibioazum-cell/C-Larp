static double enemy_grab_active(void) {
    if (egrab_state != 0) {
        return 1;
    }
    return 0;
}

static GAME_MAYBE_UNUSED double enemy_grab_holding(void) {
    if (egrab_state == 2 && pgrab_active == 1 && pgrab_slot == grab_slot_bot) {
        return 1;
    }
    return 0;
}

static void enemy_grab_swing(void) { egrab_punch_t = astra_hit_show; }

static double enemy_grab_punching(void) {
    if (egrab_punch_t > 0) {
        return 1;
    }
    return 0;
}

static void enemy_grab_clear(void) {
    egrab_state = 0;
    egrab_t = 0;
    egrab_hits = 0;
    if (pgrab_active == 1 && pgrab_slot == grab_slot_bot) {
        pgrab_active = 0;
        pgrab_slot = -1;
        pgrab_t = 0;
        pgrab_hits = 0;
    }
}

static void enemy_grab_stop(double landed) {
    enemy_grab_clear();
    if (landed == 1) {
        enemy_super_cd = enemy_astra_cd_time;
    } else {
        enemy_super_cd = astra_grab_miss_cd;
    }
}

static void enemy_start_grab(void) {
    egrab_state = 1;
    egrab_t = 0;
    egrab_hits = 0;
    egrab_x = enemy->x;
    egrab_y = enemy->y;
    egrab_dx = cos(enemy->angle);
    egrab_dy = sin(enemy->angle);
    enemy_grab_swing();
    ds_log("bot astra grab cast");
}

static void tick_enemy_grab(void) {
    if (egrab_state == 0) {
        return;
    }
    if (finished != 0 || enemy->hp <= 0 || enemy_revive_prot > 0) {
        enemy_grab_stop(0);
        return;
    }
    egrab_t = egrab_t + dt;
    if (egrab_state == 1) {
        if (egrab_t <= astra_catch_time) {
            if (pgrab_active == 0 && revive_prot <= 0 && player->hp > 0) {
                if (astra_zone_hits_player(egrab_x, egrab_y, egrab_dx, egrab_dy, enemy_level) == 1) {
                    egrab_state = 2;
                    pgrab_active = 1;
                    pgrab_slot = grab_slot_bot;
                    pgrab_t = egrab_t;
                    pgrab_hits = 0;
                    grab_cancel_actions();
                    ds_log("caught by the bot astra");
                }
            }
        } else {
            enemy_grab_stop(0);
            return;
        }
    }
    if (egrab_state != 2) {
        return;
    }
    pgrab_t = egrab_t;
    grab_quiet_player(astra_hit_interval);
    double due = astra_beats_done(egrab_t);
    while (egrab_hits < due) {
        egrab_hits = egrab_hits + 1;
        pgrab_hits = egrab_hits;
        enemy_grab_swing();
        if (take_damage(astra_beat_damage(player->max_hp)) == 1) {
            enemy_grab_stop(1);
            return;
        }
        if (player->hp <= 0 || finished != 0 || revive_prot > 0) {
            enemy_grab_stop(1);
            return;
        }
    }
    if (egrab_t >= astra_final_time()) {
        enemy_grab_swing();
        /* enemy_grab_stop() clears the grab immediately, so explicitly pulse
         * the final damage zone and let the normal fade-out render it. */
        egrab_box_a = 1;
        double dead = take_damage(astra_final_damage(player->max_hp));
        enemy_grab_stop(1);
        if (dead == 1) {
            return;
        }
        if (player->hp > 0 && finished == 0 && revive_prot <= 0) {
            throw_player(egrab_dx, egrab_dy, astra_throw_dist_for(enemy_level), astra_throw_stun_for(enemy_level));
            ds_log("thrown by the bot astra");
        }
    }
}

static double enemy_wants_grab(void) {
    if (enemy_class != CLASS_ASTRA) {
        return 0;
    }
    if (enemy_super_cd > 0 || egrab_state != 0) {
        return 0;
    }
    if (player->hp <= 0 || revive_prot > 0) {
        return 0;
    }
    if (dist(enemy->x, enemy->y, player->x, player->y) > enemy_astra_range) {
        return 0;
    }
    return 1;
}
